# Secrets never belong in the repo -- the deployed app reads them from Streamlit's own
# secrets store, so this file exists only on a developer's machine.
.streamlit/secrets.toml

# The cached source data IS committed (data/raw/*.parquet, ~19 MB). It is what lets a
# fresh deploy boot in seconds instead of making a few hundred API calls, and it pins the
# numbers a shared app is serving to something reviewable. Refresh it deliberately:
#   python run.py --refresh   (then commit the diff)
data/processed/*

# Local scenario state. The working scenario is one person's scratch pad, and saved
# scenarios belong in the shared library, not in the source tree.
scenarios/*.json

__pycache__/
*.pyc
.venv/
.DS_Store
